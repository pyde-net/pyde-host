{
  "name": "@pyde-net/host",
  "version": "0.1.0-alpha.14",
  "description": "The AssemblyScript SDK for Pyde contracts: the full pyde::* host ABI plus pointer-free ergonomic wrappers — LE codecs, 128-bit math, borsh, ctx/calldata/exit/hash, and factory child-address helpers.",
  "author": "zarah <zarah@pyde.network>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pyde-net/pyde-host"
  },
  "keywords": [
    "pyde",
    "wasm",
    "blockchain",
    "contract",
    "assemblyscript",
    "borsh"
  ],
  "main": "assembly/index.ts",
  "types": "assembly/index.ts",
  "type": "module",
  "exports": {
    ".": "./assembly/index.ts",
    "./transform": {
      "types": "./transform/dist/index.d.ts",
      "default": "./transform/dist/index.js"
    },
    "./*": "./*"
  },
  "files": [
    "assembly/",
    "transform/dist/*.js",
    "transform/dist/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "asbuild": "asc assembly/index.ts --outFile build/host.wasm --target release",
    "build:transform": "tsc -p transform/tsconfig.json",
    "prepare": "npm run build:transform",
    "test:transform": "npm run build:transform && node --test transform/dist/tests/*.spec.js",
    "test": "node tests/child.test.mjs && node tests/codec_parity.spec.mjs && npm run test:transform"
  },
  "peerDependencies": {
    "assemblyscript": ">=0.27.30 <0.29.0"
  },
  "dependencies": {
    "as-bignum": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "assemblyscript": "^0.27.30",
    "typescript": "^5.9.0"
  }
}

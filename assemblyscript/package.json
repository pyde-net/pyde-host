{
  "name": "@pyde-net/host",
  "version": "0.1.0-alpha.14",
  "description": "The AssemblyScript SDK for Pyde contracts: the full pyde::* host ABI plus pointer-free ergonomic wrappers — LE codecs, 128-bit math, borsh, ctx/calldata/exit/hash, and factory child-address helpers.",
  "author": "zarah <zarah@pyde.network>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pyde-net/pyde-host"
  },
  "keywords": [
    "pyde",
    "wasm",
    "blockchain",
    "contract",
    "assemblyscript",
    "borsh"
  ],
  "main": "assembly/index.ts",
  "types": "assembly/index.ts",
  "files": [
    "assembly/",
    "README.md"
  ],
  "scripts": {
    "asbuild": "asc assembly/index.ts --outFile build/host.wasm --target release",
    "test": "node tests/child.test.mjs && node tests/codec_parity.spec.mjs"
  },
  "peerDependencies": {
    "assemblyscript": ">=0.27.0"
  },
  "dependencies": {
    "as-bignum": "^0.3.1"
  },
  "devDependencies": {
    "assemblyscript": "^0.27.0"
  }
}
